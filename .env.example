# Frontend environment. Every variable the code reads is listed here.
# Local development: copy to .env.local. Vercel: set the same names under
# Project → Settings → Environment Variables (Production, and Preview if you want previews).
#
# NEXT_PUBLIC_* values are inlined into the JavaScript bundle at BUILD time, so they are public
# (never put a secret in one) and a change needs a new deployment ("Redeploy") to take effect.

# Base URL of the Spring Boot API, no trailing slash. Production: https://api.jachai.com
NEXT_PUBLIC_API_URL=http://localhost:8085
# Older name, still read when NEXT_PUBLIC_API_URL is not set:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8085
